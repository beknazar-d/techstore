{
  "name": "phone-market-admin",
  "productName": "Phone Market Админка",
  "version": "1.0.0",
  "description": "Phone Market — приложение администратора для Windows",
  "author": "Phone Market",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "web": "node ../scripts/copy-admin-build.mjs desktop/web",
    "start": "npm run web && electron .",
    "dist": "npm run web && electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "market.phone.admin",
    "productName": "Phone Market Админка",
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["main.cjs", "web/**/*"],
    "win": { "target": "nsis", "icon": "build/icon.png", "artifactName": "PhoneMarketAdmin-Setup-${version}.${ext}" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "shortcutName": "Phone Market Админка" }
  }
}
